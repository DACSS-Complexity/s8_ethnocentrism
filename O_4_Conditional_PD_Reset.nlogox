<?xml version="1.0" encoding="utf-8"?><model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[turtles-own [
  score played? original-color
  group-tag
  cooperate-with-same?
  cooperate-with-different?
]

to setup
  clear-all
  ask patches [ set pcolor white ]
  ask n-of 100 patches [
    sprout 1 [
    set shape "circle"
    set group-tag random 4
    set cooperate-with-same? (random 2 = 0)
    set cooperate-with-different? (random 2 = 0)
    set original-color item group-tag [blue green orange violet]
    if cooperate-with-same? and cooperate-with-different? [ set shape "circle" ]
    if cooperate-with-same? and not cooperate-with-different? [ set shape "square" ]
    if not cooperate-with-same? and not cooperate-with-different? [ set shape "triangle" ]
    if not cooperate-with-same? and cooperate-with-different? [ set shape "x" ]
    set color original-color
    set size 0.8
    set score 0
    set played? false
    ]
  ]
  reset-ticks
end

to go
  if not any? turtles [ stop ]
  ; Only this tick's payoffs affect reproduction.
  ask turtles [ set score 0 ]
  ask patches [ set pcolor white ]
  ask turtles [
    set color original-color
    set played? false
  ]
  ; Stationary agents: each undirected neighbor pair plays once.
  ; The who comparison prevents counting the same pair twice.
  ask turtles [
    let focal self
    ask turtles-on neighbors4 [
      if who > [who] of focal [
        play-pd focal
      ]
    ]
  ]
  ; Only agents present at the start of this stage can reproduce.
  ask turtles [ reproduce ]
  ; Random death is independent of score; newborns are included.
  ask turtles [
    if random-float 100 < 10 [ die ]
  ]
  tick
end

to reproduce
  let birth-chance max (list 0 (min (list 100 (12 + score))))
  if random-float 100 < birth-chance [
    let vacancies neighbors4 with [not any? turtles-here]
    if any? vacancies [
      let destination one-of vacancies
      ; hatch inherits the tag and both cooperation rules unchanged.
      hatch 1 [
        move-to destination
        set score 0
        set played? false
        set color original-color
      ]
    ]
  ]
end

to play-pd [opponent]
  ; 0 = cooperate, 1 = defect.
  ; Each player uses its own inherited rule and compares stable tags.
  let focal self
  let my-action action-toward opponent
  let their-action [action-toward focal] of opponent
  let my-payoff 0
  let their-payoff 0
  if my-action = 0 and their-action = 0 [
    set my-payoff 2
    set their-payoff 2
  ]
  if my-action = 0 and their-action = 1 [
    set my-payoff -1
    set their-payoff 3
  ]
  if my-action = 1 and their-action = 0 [
    set my-payoff 3
    set their-payoff -1
  ]
  if my-action = 1 and their-action = 1 [
    set my-payoff 0
    set their-payoff 0
  ]
  set score score + my-payoff
  set played? true
  ask opponent [
    set score score + their-payoff
    set played? true
  ]
end

to-report action-toward [opponent]
  if group-tag = [group-tag] of opponent [
    ifelse cooperate-with-same? [ report 0 ] [ report 1 ]
  ]
  ifelse cooperate-with-different? [ report 0 ] [ report 1 ]
end
]]></code>

    <button x="115" y="10" width="95" height="40" display="go" forever="true" kind="Observer" disableUntilTicks="true">go</button>
    <button x="220" y="10" width="95" height="40" display="go once" forever="false" kind="Observer" disableUntilTicks="true">go</button>

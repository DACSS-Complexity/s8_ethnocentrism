<?xml version="1.0" encoding="utf-8"?><model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[turtles-own [
  score
  played?
  original-color
]


;; Observer procedures

to setup
  clear-all
  ask patches [ set pcolor white ]
  populate
  reset-ticks
end

to go
  if ticks >= 2000 or count turtles = 0 [ stop ]

  clear-participation
  let players turtles with [
    count turtles-on neighbors4 > 0
  ]
  ask players [ play ]
  ask turtles [ reproduce ]
  ask turtles [ face-death ]
  tick
end

to clear-participation
  ask patches [ set pcolor white ]
  ask turtles [
    set color original-color
    set played? false
  ]
end

to populate
  ask n-of 100 patches [
    sprout 1 [ initialize-agent ]
  ]
end




;; Turtle procedures

to initialize-agent
  set shape "circle"
  set size 0.8
  set original-color blue
  set color original-color
  set score 0
  set played? false
end

to play
  ; Each neighboring pair plays once, rather than once per agent.
  let focal self
  let opponents (turtles-on neighbors4) with [
    who > [who] of focal
  ]

  ask opponents [
    ; Inside this ask, self is the neighbor and focal is the initiator.
    let my-move random 3
    let their-move random 3
    let payoff rps-payoff my-move their-move

    receive-payoff payoff
    ask focal [ receive-payoff (- payoff) ]
  ]
end

to receive-payoff [points]
  set score score + points
  mark-participation
end

to mark-participation
  set played? true
  set color red
  ask patch-here [ set pcolor yellow ]
end


;; Game rules

to-report rps-payoff [my-move their-move]
  ; 0 = rock, 1 = paper, 2 = scissors.

  if my-move = their-move [
    report 0
  ]

  ; Rock beats scissors, paper beats rock,
  ; scissors beats paper.
  if (my-move = 0 and their-move = 2) or
     (my-move = 1 and their-move = 0) or
     (my-move = 2 and their-move = 1) [
    report 1
  ]

  report -1
end
;; Demographic procedures: all agents are eligible, including isolates.

to reproduce
  let birth-chance max (list 0 (min (list 100 (12 + score))))
  if random-float 100 < birth-chance [
    let vacancies neighbors4 with [count turtles-here = 0]
    if count vacancies > 0 [
      let destination one-of vacancies
      hatch 1 [
        move-to destination
        set score 0
        set played? false
        set color original-color
      ]
    ]
  ]
end

to face-death
  if random-float 100 < 10 [ die ]
end

;; Observer output procedures

to-report mean-score
  let scores [score] of turtles
  if empty? scores [ report 0 ]
  report mean scores
end

to update-score-histogram
  let scores [score] of turtles
  clear-plot
  if not empty? scores [
    let lowest min scores
    let highest max scores
    set-plot-x-range (lowest - 0.5) (highest + 0.5)
    set-histogram-num-bars (highest - lowest + 1)
    histogram scores
  ]
end
]]></code>

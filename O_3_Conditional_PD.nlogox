<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[turtles-own [
  score
  played?
  original-color
  group-tag
  cooperate-with-same?
  cooperate-with-different?
]


;; Observer procedures

to setup
  clear-all
  ask patches [ set pcolor white ]
  populate
  reset-ticks
end

to go
  if ticks >= 2000 or count turtles = 0 [ stop ]

  clear-participation
  let players turtles with [
    count turtles-on neighbors4 > 0
  ]
  ask players [ play ]
  ask turtles [ reproduce ]
  ask turtles [ face-death ]
  tick
end

to clear-participation
  ask patches [ set pcolor white ]
  ask turtles [
    set color original-color
    set played? false
  ]
end

to populate
  ask n-of 100 patches [
    sprout 1 [ initialize-agent ]
  ]
end




;; Turtle procedures

to initialize-agent
  ; Random assignment happens once at setup, not during play.
  set group-tag random 4
  set cooperate-with-same? (random 2 = 0)
  set cooperate-with-different? (random 2 = 0)
  set size 0.8
  set score 0
  set played? false
  update-appearance
end

to update-appearance
  set original-color item group-tag [blue green orange violet]
  set color original-color
  if cooperate-with-same? and cooperate-with-different? [ set shape "circle" ]
  if cooperate-with-same? and not cooperate-with-different? [ set shape "square" ]
  if not cooperate-with-same? and not cooperate-with-different? [ set shape "triangle" ]
  if not cooperate-with-same? and cooperate-with-different? [ set shape "x" ]
end

to play
  ; Each neighboring pair plays once, rather than once per agent.
  let focal self
  let opponents (turtles-on neighbors4) with [
    who > [who] of focal
  ]

  ask opponents [
    ; Inside this ask, self is the neighbor and focal is the initiator.
    ; Each player applies its own rule to the other's tag.
    let neighbor self
    let my-action action-toward focal
    let their-action [action-toward neighbor] of focal
    let my-payoff pd-payoff my-action their-action
    let their-payoff pd-payoff their-action my-action

    receive-payoff my-payoff
    ask focal [ receive-payoff their-payoff ]
  ]
end

to receive-payoff [points]
  set score score + points
  mark-participation
end

to mark-participation
  set played? true
end


;; Game rules

to-report pd-payoff [my-action their-action]
  ; Cooperation costs 1 and gives the recipient 3.
  if my-action = 0 and their-action = 0 [ report 2 ]
  if my-action = 0 and their-action = 1 [ report -1 ]
  if my-action = 1 and their-action = 0 [ report 3 ]
  report 0  ; both defect
end
;; Demographic procedures: all agents are eligible, including isolates.

to reproduce
  if random-float 100 < birth-probability [
    let vacancies neighbors4 with [count turtles-here = 0]
    if count vacancies > 0 [
      let destination one-of vacancies
      hatch 1 [
        move-to destination
        set score 0
        set played? false
        set color original-color
      ]
    ]
  ]
end

to face-death
  if random-float 100 < 10 [ die ]
end

;; Turtle reporter: probability expressed as a percentage.
to-report birth-probability
  report max (list 0 (min (list 100 (12 + score))))
end

;; Turtle reporter: deterministic action, 0 = cooperate, 1 = defect.
to-report action-toward [opponent]
  if group-tag = [group-tag] of opponent [
    ifelse cooperate-with-same? [ report 0 ] [ report 1 ]
  ]
  ifelse cooperate-with-different? [ report 0 ] [ report 1 ]
end

;; Observer reporters for the population plot.
to-report humanitarian-count
  report count turtles with [cooperate-with-same? and cooperate-with-different?]
end

to-report ethnocentric-count
  report count turtles with [cooperate-with-same? and not cooperate-with-different?]
end

to-report egoist-count
  report count turtles with [not cooperate-with-same? and not cooperate-with-different?]
end

to-report traitorous-count
  report count turtles with [not cooperate-with-same? and cooperate-with-different?]
end
]]></code>
  <widgets>
    <view x="10" wrappingAllowedX="true" y="65" frameRate="30.0" minPycor="-16" height="433" showTickCounter="true" patchSize="13.0" fontSize="10" wrappingAllowedY="true" width="433" tickCounterLabel="ticks" maxPycor="16" updateMode="1" maxPxcor="16" minPxcor="-16"></view>
    <button x="10" y="10" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="95" display="setup">setup</button>
    <button x="115" y="10" height="40" disableUntilTicks="true" forever="true" kind="Observer" width="95" display="go">go</button>
    <button x="220" y="10" height="40" disableUntilTicks="true" forever="false" kind="Observer" width="95" display="go once">go</button>
    <monitor x="455" precision="0" y="65" height="60" fontSize="12" width="130" display="Population">count turtles</monitor>
    <plot x="455" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="Agents" y="140" xMin="0.0" height="350" legend="true" xMax="100.0" yMin="0.0" width="510" xAxis="Ticks" display="Population by strategy">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Humanitarian" color="-16777216" legend="true">
        <setup></setup>
        <update>plot humanitarian-count</update>
      </pen>
      <pen interval="1.0" mode="0" display="Ethnocentric" color="-2674135" legend="true">
        <setup></setup>
        <update>plot ethnocentric-count</update>
      </pen>
      <pen interval="1.0" mode="0" display="Egoist" color="-13345367" legend="true">
        <setup></setup>
        <update>plot egoist-count</update>
      </pen>
      <pen interval="1.0" mode="0" display="Traitorous" color="-10899396" legend="true">
        <setup></setup>
        <update>plot traitorous-count</update>
      </pen>
    </plot>
  </widgets>
  <info><![CDATA[## O_3: Inherited group-conditional profiles

### Purpose: replacing random choices with inherited rules

O_2 agents randomly choose cooperate or defect at every encounter. O_3 replaces that choice with an inherited behavioral profile. Each agent compares its partner's tag with its own and applies the appropriate rule. CHOOSING DURING PLAY IS NOT RANDOM.

Tags and cooperation flags are assigned randomly once at setup. Offspring inherit them unchanged. Given an agent's flags and its partner's tag, action-toward always reports the same action. There is no memory, learning, mutation, or immigration.

### How to use

Click setup, then go or go once. Execution stops at 2000 ticks or extinction. The world starts with 100 agents on distinct random patches in a 33 by 33 wrapping grid.

### States

- score: cumulative PD payoff, initially zero. It affects birth probability and is not reset each tick in O_3.
- played?: whether the agent participated this tick. It records participation without limiting games.
- original-color: the display color corresponding to group-tag.
- group-tag: an observable group marker, from 0 to 3.
- cooperate-with-same?: Boolean rule for a partner with the same tag.
- cooperate-with-different?: Boolean rule for a partner with another tag.

Neighbors are computed when needed, not stored as state. Tags do not themselves determine profiles: any profile can occur within any tag.

### Four behavioral profiles

| Profile | Same tag | Different tag | Shape |
| --- | --- | --- | --- |
| Humanitarian | Cooperate | Cooperate | Circle |
| Ethnocentric | Cooperate | Defect | Square |
| Egoist | Defect | Defect | Triangle |
| Traitorous | Defect | Cooperate | X |

Example: an ethnocentric agent cooperates with any same-tag neighbor and defects against any different-tag neighbor, regardless of earlier encounters. A same-tag egoist still defects against it.

The model specifies these four profiles; their population prevalence is an outcome to investigate. Agents do not invent profiles during play.

### Code and schedule

setup clears the world, colors patches white, calls populate, and resets CLOCK. populate creates agents on 100 distinct patches. initialize-agent randomly assigns tag and cooperation flags, initializes score and participation, then calls update-appearance.

go keeps the O_2 schedule:
1. Stop at 2000 ticks or extinction.
2. clear-participation restores group colors and clears played?, without resetting scores.
3. Select agents with count turtles-on neighbors4 > 0.
4. Ask selected agents to play.
5. Ask agents to reproduce.
6. Ask the current population, including newborns, to face-death.
7. tick advances CLOCK and updates the plot.

### Play and reporters

play identifies cardinal neighbors with a higher who number, ensuring every occupied neighboring pair plays once per tick. Both actions and payoffs are resolved together. Every eligible partner is visited; none is selected as a single random game partner.

Inside ask opponents, neighbor stores the active neighboring agent and focal retains the initiator. Each player calls action-toward from its own perspective. That reporter compares group-tag values and returns 0 for cooperation or 1 for defection from the corresponding inherited Boolean. It contains no random draw.

pd-payoff retains O_2's table: CC gives 2 each; CD gives -1 to the cooperator and 3 to the defector; DD gives 0 each. receive-payoff adds points and calls mark-participation, which only records played?. Neither red players nor yellow patches are used.

### Reproduction, inheritance, and death

birth-probability reports 12 + cumulative score, bounded to 0-100 percent. reproduce gives each existing agent one chance to create an offspring on a random empty neighbors4 patch. No vacancy means no birth. Scores are not spent. Isolates do not play, but can reproduce and die.

hatch copies the parent's tag, flags, shape and color. It places the newborn on its birth patch and resets score to zero and played? to false. Existing agents remain fixed. Newborns do not play or reproduce until the next tick, but face the current tick's random death stage.

face-death gives each agent an independent 10% death chance, unrelated to score. With no mutation or immigration, extinct traits cannot return.

### What is random, and what is not?

Random: setup locations and initial traits; activation order; birth and death events; and selection of a vacant birth patch. These affect the population trajectory.

Not random: whether an agent cooperates with a given tag. Its inherited rules determine that action. Repeated encounters do not teach or change the rules.

### Display and population reporters

Agent color represents group-tag: 0 blue, 1 green, 2 orange, 3 violet. Shape represents profile. Agents compare group-tag, not display color or shape.

The population plot's lines count profiles across all tags: Humanitarian (black), Ethnocentric (red), Egoist (blue), Traitorous (green). Plot colors do not represent the world’s tag colors.

Each pen calls its named reporter: humanitarian-count, ethnocentric-count, egoist-count, or traitorous-count. Their sum equals count turtles. The population monitor reports the total. The plot accumulates history instead of clearing every tick. Scores remain internal to reproduction.

### Next step and relation to HA

O_3 keeps lifetime score accumulation. O_4 will reset score each tick, aligning payoff persistence with HA's per-cycle reproductive reset. O_3 does not yet include mutation or immigration. Its group-conditional choices reflect the four inherited profiles in Hammond and Axelrod, while its initial population, world size and cumulative-score reproduction remain teaching choices.

Source: Hammond and Axelrod (2006), The Evolution of Ethnocentrism, manuscript pp. 3-4: https://websites.umich.edu/~axe/research/Hammond%20and%20Axelrod%20JCR%2006.pdf

### Credits

Professor Jose Manuel MAGALLANES  
Complexity and ABM, 2026  
DACSS - UMASS
]]></info>

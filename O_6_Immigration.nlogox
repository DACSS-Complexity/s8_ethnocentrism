<?xml version="1.0" encoding="utf-8"?><model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[;; Each agent stores its own state. Temporary encounter/mutation flags
;; are local variables inside procedures, not additional agent states.
turtles-own [
  score           ; payoffs earned during the current tick
  played?         ; participation record; does not limit games
  original-color  ; display color for the agent's group
  group-tag       ; inherited observable marker: 0, 1, 2, or 3
  profile         ; inherited behavioral profile, stored as text
]


;; Observer procedures

; Construct the population and initialize CLOCK.
to setup
  clear-all
  ask patches [ set pcolor white ]
  populate
  reset-ticks
end

; Main schedule: immigration, current payoffs, games, birth, death, CLOCK.
to go
  if ticks >= 2000 [ stop ]

  immigrate
  reset-scores
  clear-participation
  ; Only non-isolated agents play. Isolates can still reproduce or die.
  let players turtles with [
    count turtles-on neighbors4 > 0
  ]
  ask players [ play ]
  ; This ask includes only agents present when reproduction begins.
  ask turtles [ reproduce ]
  ; This later ask includes newborns as well as surviving parents.
  ask turtles [ face-death ]
  tick
end

to immigrate
  ; Arrival can occur on any empty patch, independently of local parents.
  let vacancies patches with [count turtles-here = 0]
  if count vacancies > 0 [
    ask one-of vacancies [
      ; Reuse initialization: independent random tag and profile, score zero.
      ; An immigrant is not an offspring and does not mutate on arrival.
      sprout 1 [ initialize-agent ]
    ]
  ]
end

to reset-scores
  ; Only this tick's payoffs affect reproduction.
  ask turtles [ set score 0 ]
end

; Clear participation records without changing tags, profiles, or scores.
to clear-participation
  ask patches [ set pcolor white ]
  ask turtles [
    set color original-color
    set played? false
  ]
end

; Distinct birth locations ensure at most one agent per patch.
to populate
  ask n-of 100 patches [
    sprout 1 [ initialize-agent ]
  ]
end




;; Turtle procedures

to initialize-agent
  ; Assign initial traits independently. During play, profiles determine actions.
  set group-tag random 4
  set profile one-of ["humanitarian" "ethnocentric" "egoist" "traitorous"]
  set size 0.8
  set score 0
  set played? false
  update-appearance
end

; Colors show tags; shapes show profiles. Display does not decide actions.
to update-appearance
  set original-color item group-tag [blue green orange violet]
  set color original-color
  if profile = "humanitarian" [ set shape "circle" ]
  if profile = "ethnocentric" [ set shape "square" ]
  if profile = "egoist" [ set shape "triangle" ]
  if profile = "traitorous" [ set shape "x" ]
end

to play
  ; Each neighboring pair plays once, rather than once per agent.
  let focal self
  let opponents (turtles-on neighbors4) with [
    who > [who] of focal
  ]

  ask opponents [
    ; Inside this ask, self is the neighbor and focal is the initiator.
    ; Each player applies its own rule to the other's tag.
    let neighbor self
    let my-action action-toward focal
    let their-action [action-toward neighbor] of focal
    let my-payoff pd-payoff my-action their-action
    let their-payoff pd-payoff their-action my-action

    receive-payoff my-payoff
    ask focal [ receive-payoff their-payoff ]
  ]
end

to receive-payoff [points]
  set score score + points
  mark-participation
end

to mark-participation
  set played? true
end


;; Game rules

to-report pd-payoff [my-action their-action]
  ; Cooperation costs 1 and gives the recipient 3.
  if my-action = 0 and their-action = 0 [ report 2 ]
  if my-action = 0 and their-action = 1 [ report -1 ]
  if my-action = 1 and their-action = 0 [ report 3 ]
  report 0  ; both defect
end
;; Demographic procedures: all agents are eligible, including isolates.

; One birth attempt per parent. Successful probability still needs space.
to reproduce
  if random-float 100 < birth-probability [
    let vacancies neighbors4 with [count turtles-here = 0]
    if count vacancies > 0 [
      let destination one-of vacancies
      ; Inherit first, then mutate the newborn independently of neighbors.
      hatch 1 [
        ; hatch copies the parent; move-to places the NEWBORN, not the parent.
        move-to destination
        set score 0
        set played? false
        ; Only this newborn mutates. The parent remains unchanged.
        mutate
        ; Refresh the inherited display after possible trait changes.
        update-appearance
      ]
    ]
  ]
end

; Mortality is random and independent of score, tag, and profile.
to face-death
  if random-float 100 < 10 [ die ]
end

;; Turtle reporter: probability expressed as a percentage.
to-report birth-probability
  ; Scores reset each tick; the baseline is 12 percentage points.
  report max (list 0 (min (list 100 (12 + score))))
end

;; Turtle reporter: deterministic action, 0 = cooperate, 1 = defect.
to-report action-toward [opponent]
  ; Local flag: computed for this encounter, not stored as agent state.
  let same-group? (group-tag = [group-tag] of opponent)

  if profile = "humanitarian" [ report 0 ]
  if profile = "egoist" [ report 1 ]
  if profile = "ethnocentric" [
    ifelse same-group? [ report 0 ] [ report 1 ]
  ]
  if profile = "traitorous" [
    ifelse same-group? [ report 1 ] [ report 0 ]
  ]
  error (word "Unknown profile: " profile)
end

;; Observer reporters for the population plot.
to-report humanitarian-count
  report count turtles with [profile = "humanitarian"]
end

to-report ethnocentric-count
  report count turtles with [profile = "ethnocentric"]
end

to-report egoist-count
  report count turtles with [profile = "egoist"]
end

to-report traitorous-count
  report count turtles with [profile = "traitorous"]
end

;; MUTATION AT BIRTH
;; Three independent tests: tag and two underlying behavioral traits.
;; No neighborhood trigger, memory, score dependence, or parent mutation.
to mutate
  let mutation-rate 0.5  ; percent per trait, following HA

  ; Decode the inherited profile into temporary Boolean flags.
  ; These flags exist only while this procedure executes.
  let help-same? member? profile ["humanitarian" "ethnocentric"]
  let help-different? member? profile ["humanitarian" "traitorous"]

  ; Test 1: 0.5% chance of a different tag, uniformly among the other three.
  if random-float 100 < mutation-rate [
    set group-tag one-of (remove group-tag [0 1 2 3])
  ]
  ; Test 2: independently flip the same-group rule with probability 0.5%.
  if random-float 100 < mutation-rate [
    set help-same? not help-same?
  ]
  ; Test 3: independently flip the different-group rule with probability 0.5%.
  if random-float 100 < mutation-rate [
    set help-different? not help-different?
  ]

  ; Store the resulting profile, discarding the temporary flags afterward.
  ; Either rule flip changes profile; flipping both changes it too.
  ; P(profile changes) = 1 - (0.995 * 0.995) = 0.009975 = 0.9975%.
  ; Tag change is independent: neither, either, or both tag/profile may change.
  set profile profile-from-rules help-same? help-different?
end

; Encode the two temporary rules as one persistent profile name.
to-report profile-from-rules [help-same? help-different?]
  if help-same? and help-different? [ report "humanitarian" ]
  if help-same? and not help-different? [ report "ethnocentric" ]
  if not help-same? and help-different? [ report "traitorous" ]
  report "egoist"
end
]]></code>
